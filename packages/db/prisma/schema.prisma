generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// Minimal bootstrap model used to verify the database toolchain.
// Authentication-specific fields and the rest of the domain schema belong in separate issues.
model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique @db.VarChar(320)
  displayName String?  @db.VarChar(80)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
